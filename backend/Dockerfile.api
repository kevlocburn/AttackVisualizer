FROM python:3.14-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Run the log scraper every 10 minutes in the background
RUN printf '#!/bin/sh\nwhile true; do\n    /usr/local/bin/python3 /app/scripts/log_scraper_docker.py >> /var/log/log_scraper_docker.log 2>&1\n    sleep 600\ndone\n' > /app/run_scraper.sh && chmod +x /app/run_scraper.sh

EXPOSE 8000

# Start both the scraper loop and the FastAPI server
CMD ["sh", "-c", "/app/run_scraper.sh & uvicorn api:app --host 0.0.0.0 --port 8000"]
